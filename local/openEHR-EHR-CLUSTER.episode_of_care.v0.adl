definition
	CLUSTER[at0000] matches {    -- Episode of care - Additional Info
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Sensitivity
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- Normal
							at0004,    -- High
							at0005]    -- None
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Service type
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Encounter class
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Encounter state
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0008,    -- Draft
							at0009,    -- Progress
							at0010]    -- Completed
						}
					}
				}
			}
		}
	}

