definition
	CLUSTER[at0000] matches {    -- Additional Context
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Encounter ID
				value matches {
					DV_IDENTIFIER matches {
						issuer matches {/EHACare/}
						type matches {/admission/}
						assigner matches {/facility code/}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Admission ID
				value matches {
					DV_IDENTIFIER matches {
						issuer matches {/EHACare/}
						type matches {/encounter/}
						assigner matches {/facility code/}
					}
				}
			}
		}
	}

