definition
	CLUSTER[at0000] matches {    -- Additional context
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Encounter ID
				value matches {
					DV_IDENTIFIER matches {
						issuer matches {/EHACare/}
						type matches {/admission/}
						assigner matches {/facility code/}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Admission ID
				value matches {
					DV_IDENTIFIER matches {
						issuer matches {/EHACare/}
						type matches {/encounter/}
						assigner matches {/facility code/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Additional context">
					description = <"Shared operational context for EHACare compositions, carrying encounter and admission identifiers. Bound to EVENT_CONTEXT/other_context in every encounter-scoped template.">
				>
				["at0001"] = <
					text = <"Encounter ID">
					description = <"">
				>
				["at0002"] = <
					text = <"Admission ID">
					description = <"Admission identifier">
				>
			>
		>
	>
